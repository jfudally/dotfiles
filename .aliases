# ~/.aliases — shared shell aliases, portable across macOS and Ubuntu.
#
# Aliases that shadow a standard command (ls, cat, grep) are defined only when
# the replacement is actually installed, so a host without it falls back to the
# real tool instead of erroring on every invocation.

# ── General ──────────────────────────────────────────────────────────────────

if command -v lsd >/dev/null 2>&1; then
  alias ls='lsd'
fi
alias ll="ls -altr"

alias ohmyconfig="vi ~/.zshrc"
alias ohmyrefresh="source ~/.zshrc"

# ── Goto ─────────────────────────────────────────────────────────────────────

alias gowork="cd ~/workspace"
alias goscripts="cd ~/workspace/scripts"

# ── Docs / Notes ─────────────────────────────────────────────────────────────

alias notes="vi ~/notes.txt"

# ── Common replacements ──────────────────────────────────────────────────────

if command -v rg >/dev/null 2>&1; then
  alias grep="rg"
fi

# Debian and Ubuntu ship bat as `batcat` to avoid clashing with the bacula
# package. install.sh also symlinks it to ~/.local/bin/bat, but check both so
# the alias works on a host set up by hand.
if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
elif command -v batcat >/dev/null 2>&1; then
  alias cat="batcat"
  alias bat="batcat"
fi

# Likewise fd, which Debian/Ubuntu package as `fdfind`.
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  alias fd="fdfind"
fi

alias curl="curl -k"

# ── Network ──────────────────────────────────────────────────────────────────

# DNS cache flushing is entirely platform-specific: macOS restarts
# mDNSResponder, systemd-resolved has its own command, and nscd is the
# fallback on hosts without systemd-resolved.
case "$(uname -s)" in
  Darwin)
    alias dns-flush="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
    ;;
  Linux)
    if command -v resolvectl >/dev/null 2>&1; then
      alias dns-flush="sudo resolvectl flush-caches"
    elif command -v systemd-resolve >/dev/null 2>&1; then
      alias dns-flush="sudo systemd-resolve --flush-caches"
    else
      alias dns-flush="sudo systemctl restart nscd"
    fi
    ;;
esac

alias lsof-port="sudo lsof -nP -i :"

# ── Platform convenience ─────────────────────────────────────────────────────

# `open` is macOS's file/URL opener; xdg-open is the Linux equivalent.
if [[ "$(uname -s)" == "Linux" ]] && command -v xdg-open >/dev/null 2>&1; then
  alias open="xdg-open"
fi

# pbcopy/pbpaste are macOS clipboard tools. Map them onto xclip where present
# so pipelines written on the Mac keep working on a Linux desktop.
if [[ "$(uname -s)" == "Linux" ]] && command -v xclip >/dev/null 2>&1; then
  alias pbcopy="xclip -selection clipboard"
  alias pbpaste="xclip -selection clipboard -o"
fi
